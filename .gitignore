# Local configuration and credentials
/config.json
/config.json.tmp
/.env
/.env.*
!/.env.example

# Private prompts, records, images and screenshots
/user_data/
/screenshots/

# Local model weights and generated sharing archives
/models/*.gguf
/dist/

# Packed launcher and release bundles — shipped through GitHub Releases, not git
/SPEC7.exe
/publish/
# onefile extraction folder created next to the exe on first launch
/.runtime/

# Local scratch space, rename backups and one-shot migration scripts
/.tmp/
/.rename-backup-*/
/.rename-*.mjs
/.rename_*.py
/.fix-*.mjs

# Front-end backup copies and transient data notes
/public/*.bak-*
/data/_miss_tmp.txt

# Glossary build intermediates (regenerated by tools/split.py, tools/dump.py, tools/make_xlsx.py)
/data/shards/
/data/_*.txt
/data/glossary_zh.*
/data/build_report.txt
/data/parts/*.unknown.txt

# Runtime / editor artifacts
__pycache__/
*.py[cod]
*.log
.venv/
.vscode/
.idea/
